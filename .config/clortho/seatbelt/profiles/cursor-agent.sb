; clortho profile: cursor-agent
; generated by:  clortho profile create
; edit with:     clortho profile edit cursor-agent
; clortho:env-patterns: CURSOR_*

; --- defines ---
; CURSOR
(define cursor_config_dir "${CLORTHO_ENV_CURSOR_CONFIG_DIR:-${CLORTHO_ENV_HOME}/.cursor}")
(define _homebrew_prefix "${CLORTHO_ENV_HOMEBREW_PREFIX:-/opt/homebrew}")

; --- mach rules ---
(allow mach-lookup
    (global-name "com.apple.SecurityServer"))

; --- preserved SBPL ---
(define
    (homebrew-literal rel)
    (literal
        (string-append _homebrew_prefix rel)))
(allow file-read*
    (home-subpath "/Library/Application Support/Cursor")
    (literal "/Applications")
    (literal "/usr/local/bin/cursor")
    (homebrew-literal "/bin/cursor")
    (subpath "/Applications/Cursor.app"))
(allow file-read*
    (apply require-any
        (path-literals cursor_config_dir))
    (literal "/Library/Preferences/com.apple.security.plist")
    (home-literal "/Library/Preferences/com.apple.security.plist"))
(allow file-read* file-write*
    (home-prefix "/.local/bin/agent")
    (home-prefix "/.local/bin/cursor-agent")
    (home-prefix "/.local/bin/cursor")
    (xdg-data-subpath "/cursor-agent")
    (xdg-config-subpath "/cursor")
    (xdg-cache-subpath "/cursor-compile-cache")
    (subpath cursor_config_dir)
    (home-subpath "/Library/Caches/cursor-compile-cache")
    (home-subpath "/Library/Keychains"))
