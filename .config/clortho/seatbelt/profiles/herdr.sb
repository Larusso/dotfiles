; clortho profile: herdr
; generated by:  clortho profile create
; edit with:     clortho profile edit herdr
; clortho:env-patterns: HC_*

; --- defines ---
(define clortho_env_herdr_xdg_config_home "${CLORTHO_ENV_XDG_CONFIG_HOME:-__CLORTHO_HOME__/.config}")

; --- path rules ---
; Herdr application modification configs
(allow file-read* file-write*
    (subpath
        (string-append clortho_env_herdr_xdg_config_home "/herdr-app")))

; --- process rules ---
(allow process-info*)

; --- rules with modifiers ---
(allow process-exec
    (with no-sandbox)
    (literal "/bin/ps"))
