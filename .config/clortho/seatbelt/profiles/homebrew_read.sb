; clortho profile: homebrew_read
; generated by:  clortho profile create
; edit with:     clortho profile edit homebrew_read
; clortho:env-patterns: HOMEBREW_*

; --- defines ---
(define homebrew_cache_dir "${CLORTHO_ENV_HOMEBREW_CACHE:-${CLORTHO_ENV_HOME}/Library/Caches/Homebrew}")
(define homebrew_prefix "${CLORTHO_ENV_HOMEBREW_PREFIX:-/opt/homebrew}")
(define homebrew_cellar "${CLORTHO_ENV_HOMEBREW_CELLAR:-/opt/homebrew/Cellar}")
(define homebrew_repository "${CLORTHO_ENV_HOMEBREW_REPOSITORY:-/opt/homebrew}")

; --- path rules ---
(allow file-read*
    (subpath homebrew_cache_dir)
    (subpath homebrew_prefix)
    (subpath homebrew_cellar)
    (subpath homebrew_repository))

; --- preserved SBPL ---
(allow file-read*
    (apply require-any
        (path-literals homebrew_cache_dir))
    (apply require-any
        (path-literals homebrew_prefix))
    (apply require-any
        (path-literals homebrew_cellar))
    (apply require-any
        (path-literals homebrew_repository)))
