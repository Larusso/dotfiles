; clortho profile: clortho-config-read
; generated by:  clortho profile create
; edit with:     clortho profile edit clortho-config-read

; --- defines ---
(define clortho_env_clortho_config_read_xdg_config_home "${CLORTHO_ENV_XDG_CONFIG_HOME:-__CLORTHO_HOME__/.config}")
(define clortho_env_clortho_config_read_xdg_data_home "${CLORTHO_ENV_XDG_DATA_HOME:-__CLORTHO_HOME__/.local/share}")

; --- path rules ---
(allow file-read* file-search file-test-existence
    (subpath
        (string-append clortho_env_clortho_config_read_xdg_config_home "/clortho")))
(allow file-read* file-search
    (subpath
        (string-append clortho_env_clortho_config_read_xdg_data_home "/clortho")))
