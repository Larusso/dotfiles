; clortho profile: dotnet2
; generated by:  clortho profile create
; edit with:     clortho profile edit dotnet2

; --- defines ---
(define foo "${CLORTHO_ENV_HOME}")

; --- network rules ---
(allow network-inbound
    (remote ip))
(allow network-outbound
    (remote ip))
(allow network-bind
    (subpath foo))
