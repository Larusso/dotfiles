; clortho profile: git-config-read
; generated by:  clortho profile create
; edit with:     clortho profile edit git-config-read

; --- defines ---
(define clortho_env_git_config_read_xdg_config_home "${CLORTHO_ENV_XDG_CONFIG_HOME:-__CLORTHO_HOME__/.config}")

; --- path rules ---
(allow file-read* file-search file-test-existence
    (subpath
        (string-append clortho_env_git_config_read_xdg_config_home "/git"))
    (home-literal "/.gitconfig"))
