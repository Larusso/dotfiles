; clortho profile: claude
; generated by:  clortho profile create
; edit with:     clortho profile edit claude
; clortho:env-patterns: CLAUDE_CODE_*,ANTHROPIC_*,API_FORCE_IDLE_TIMEOUT,API_TIMEOUT_MS,AWS_BEARER_TOKEN_BEDROCK,BASH_DEFAULT_TIMEOUT_MS,BASH_MAX_OUTPUT_LENGTH,BASH_MAX_TIMEOUT_MS,CCR_FORCE_BUNDLE,CLAUDECODE,CLAUDE_AGENT_SDK_*,CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS,CLAUDE_AUTO*,CLAUDE_AX_SCREEN_READER,CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR,CLAUDE_CLIENT_PRESENCE_FILE,CLAUDE_CODE_*,DEBUG,DISABLE_AUTOUPDATER,DISABLE_ERROR_REPORTING,DISABLE_FEEDBACK_COMMAND,DISABLE_TELEMETRY,DO_NOT_TRACK,ENABLE_TOOL_SEARCH,GCLOUD_PROJECT,GOOGLE_APPLICATION_CREDENTIALS,GOOGLE_CLOUD_PROJECT,MAX_THINKING_TOKENS

; --- defines ---
; CLAUDE
(define claude_code_debug_log_file "${CLORTHO_ENV_CLAUDE_CODE_DEBUG_LOGS_DIR:-/dev/null}")
(define claude_code_plugin_cache_dir "${CLORTHO_ENV_CLAUDE_CODE_PLUGIN_CACHE_DIR:-${CLORTHO_ENV_HOME}/.claude/plugins}")
; Path to one or more read-only plugin seed directories, separated by : on Unix or ; on Windows.
; Use this to bundle a pre-populated plugins directory into a container image.
; Claude Code registers marketplaces from these directories at startup and uses
; pre-cached plugins without re-cloning
(define claude_code_plugin_seed_dir "${CLORTHO_ENV_CLAUDE_CODE_PLUGIN_SEED_DIR:-/dev/null}")
(define claude_code_temp_dir "${CLORTHO_ENV_CLAUDE_CODE_TEMP_DIR:-/tmp}")
(define claude_code_config_dir "${CLORTHO_ENV_CLAUDE_CONFIG_DIR:-${CLORTHO_ENV_HOME}/.claude/}")
(define claude_code_env_file "${CLORTHO_ENV_CLAUDE_ENV_FILE:-/dev/null}")

; --- path rules ---
(allow file-read* file-write*
    (literal claude_code_debug_log_file)
    (literal claude_code_env_file)
    (subpath claude_code_config_dir)
    (subpath claude_code_plugin_seed_dir)
    (subpath claude_code_temp_dir)
    (subpath claude_code_plugin_cache_dir)
    (home-literal "/.claude.json")
    (home-literal "/.claude.json*")
    (home-subpath "/Library/Keychains"))
(allow file-read* file-write* file-search file-test-existence
    (subpath "/Library/Application Support/ClaudeCode"))

; --- mach rules ---
(allow mach-lookup
    (global-name "com.apple.SecurityServer"))

; --- preserved SBPL ---
(allow file-read*
    (literal "/Library/Preferences/com.apple.security.plist")
    (home-literal "/Library/Preferences/com.apple.security.plist")
    (apply require-any
        (path-literals claude_code_debug_log_file))
    (apply require-any
        (path-literals claude_code_plugin_cache_dir))
    (apply require-any
        (path-literals claude_code_temp_dir))
    (apply require-any
        (path-literals claude_code_config_dir))
    (apply require-any
        (path-literals claude_code_env_file))
    (apply require-any
        (path-list-literals claude_code_plugin_seed_dir #\:)))
