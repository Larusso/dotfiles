; clortho profile: tool:pi:pi
; generated by:  clortho tool edit
; edit with:     clortho tool edit pi --local-profile pi
; clortho:env-patterns: PI_CODING_AGENT_DIR

; --- defines ---
(define clortho_env_tool_pi_pi_home "${CLORTHO_ENV_HOME}")
(define clortho_env_tool_pi_pi_pi_coding_agent_dir "${CLORTHO_ENV_PI_CODING_AGENT_DIR}")

; --- path rules ---
(allow file-read* file-write* file-search file-test-existence
    (subpath
        (string-append clortho_env_tool_pi_pi_home "/.pi"))
    (subpath clortho_env_tool_pi_pi_pi_coding_agent_dir))
