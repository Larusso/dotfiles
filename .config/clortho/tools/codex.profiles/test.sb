; clortho profile: tool:codex:test
; generated by:  clortho tool edit
; edit with:     clortho tool edit codex --local-profile test

; --- rules with modifiers ---
(allow process-exec*
    (with report)
    (with telemetry)
    (with telemetry-backtrace)
    (with no-sandbox)
    (with no-callout)
    (with message "Wohoooo")
    (with send-signal SIGKILL)
    (literal "/bin/bash"))
