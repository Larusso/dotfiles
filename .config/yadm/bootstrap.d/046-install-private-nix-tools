#!/usr/bin/env zsh
source "${XDG_CONFIG_HOME:-$HOME/.config}/yadm/lib.zsh"

log_header "Install Private Nix Tools"

if ! command -v nix >/dev/null 2>&1; then
  log_skip "Nix not available"
  exit 0
fi

# 1Password SSH agent socket — macOS uses a Group Containers path, Linux uses ~/.1password/
typeset -a op_sockets=(
  "${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  "${HOME}/.1password/agent.sock"
)
for sock in "${op_sockets[@]}"; do
  [[ -S "$sock" ]] && export SSH_AUTH_SOCK="$sock" && break
done

if ! ssh-add -l >/dev/null 2>&1; then
  log_warn "1Password SSH agent not running or has no keys — skipping private nix tools"
  log_warn "Start 1Password, enable SSH agent, and re-run bootstrap"
  exit 0
fi

classes=(${(f)"$(yadm config --get-all local.class 2>/dev/null || true)"})
context=""
for class in "${classes[@]}"; do
  [[ "$class" == context:* ]] && context="${class#context:}" && break
done

case "$context" in
  work)
    REPO="git+ssh://git@github.com/wooga/ai-engineering-clortho-poc"
    ;;
  private)
    REPO="git+ssh://git@github.com/Larusso/clortho"
    ;;
  *)
    log_skip "No private nix profile for context '${context:-unset}'"
    exit 0
    ;;
esac

typeset -a packages=(clortho gozer)

for pkg in "${packages[@]}"; do
  flake_ref="${REPO}#${pkg}"
  if NO_COLOR=1 nix profile list 2>/dev/null \
      | sed $'s/\x1b\\[[0-9;]*m//g' \
      | awk -v ref="$flake_ref" '/^Original flake URL:/ { url=$0; sub(/^Original flake URL:[[:space:]]*/,"",url); if(url==ref) found=1 } END { exit found?0:1 }'; then
    log_step "Upgrading $pkg (context:$context)..."
    nix profile upgrade "$pkg"
  else
    log_step "Installing $pkg (context:$context)..."
    nix profile add "$flake_ref"
  fi
done

log_done
