#!/usr/bin/env zsh
setopt ERR_EXIT PIPE_FAIL
source "${XDG_CONFIG_HOME:-$HOME/.config}/yadm/lib.zsh"

log_header "Switch Home Manager"

log_step "Rendering machine profile"
yadm alt

# Source Nix if it was just installed in this bootstrap run
if ! command -v nix >/dev/null 2>&1; then
  NIX_PROFILE="/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
  [[ -f "$NIX_PROFILE" ]] && source "$NIX_PROFILE"
fi

if ! command -v nix >/dev/null 2>&1; then
  log_skip "Nix not available"
  exit 0
fi

FLAKE="${0:A:h:h}"
machine="${FLAKE}/home/machine.nix"
if [[ ! -f "$machine" ]]; then
  log_skip "Home Manager machine profile was not generated"
  exit 0
fi

system=$(nix eval --impure --raw --expr builtins.currentSystem)

# These used to be `nix profile add`ed from the context flake. Home Manager
# installs them now, and the old entries would collide on the same binaries.
while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  log_step "Removing Nix profile now provided by Home Manager: ${name}"
  nix profile remove "$name"
done < <(NO_COLOR=1 nix profile list 2>/dev/null \
  | sed $'s/\x1b\\[[0-9;]*m//g' \
  | awk '
      /^Name:/ { name = $2 }
      /^Original flake URL:/ {
        url = $0
        sub(/^Original flake URL:[[:space:]]*/, "", url)
        if (url ~ /ai-engineering-clortho-poc/ || url ~ /github.com\/Larusso\/clortho/ || url ~ /Larusso\/unity-version-manager/)
          print name
      }
    ')

log_step "Switching Home Manager: ${system}"
nix run "path:${FLAKE}#home-manager" -- switch --flake "path:${FLAKE}#${system}"
log_done "Home Manager switched: ${system}"
