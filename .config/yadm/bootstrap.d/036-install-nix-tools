#!/usr/bin/env zsh
source "${XDG_CONFIG_HOME:-$HOME/.config}/yadm/lib.zsh"

log_header "Install Nix Tools"

# Source Nix if it was just installed in this bootstrap run
if ! command -v nix >/dev/null 2>&1; then
  NIX_PROFILE="/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
  [[ -f "$NIX_PROFILE" ]] && source "$NIX_PROFILE"
fi

if ! command -v nix >/dev/null 2>&1; then
  log_skip "Nix not available"
  exit 0
fi

FLAKE="${0:A:h:h}"
classes=(${(f)"$(yadm config --get-all local.class 2>/dev/null || true)"})

function has_value() {
  local expected="$1"
  shift
  local current

  for current in "$@"; do
    [[ "$current" == "$expected" ]] && return 0
  done

  return 1
}

# Returns the stored Original flake URL for a named profile, or empty string
function get_profile_url() {
  local profile="$1"
  NO_COLOR=1 nix profile list 2>/dev/null \
    | sed $'s/\x1b\\[[0-9;]*m//g' \
    | awk -v profile="$profile" '
        /^Name:/ { name = $2 }
        /^Original flake URL:/ {
          if (name == profile) {
            url = $0; sub(/^Original flake URL:[[:space:]]*/, "", url); print url; exit
          }
        }
      '
}

# Returns all profile names currently installed from this flake URL
function installed_profiles_from_this_flake() {
  local flake_url="path:${FLAKE}"

  NO_COLOR=1 nix profile list 2>/dev/null \
    | sed $'s/\x1b\\[[0-9;]*m//g' \
    | awk -v flake_url="$flake_url" '
        /^Name:/ { name = $2 }
        /^Original flake URL:/ {
          url = $0
          sub(/^Original flake URL:[[:space:]]*/, "", url)
          if (url == flake_url) { print name }
        }
      '
}

typeset -a desired_profiles
desired_profiles=(yadm)
typeset context="" type_val=""

for class in "${classes[@]}"; do
  case "$class" in
    context:*) context="${class#context:}" ;;
    type:*)    type_val="${class#type:}" ;;
  esac
done

if (( ${#classes} == 0 )); then
  log_warn "No machine class set — only yadm will be installed"
elif [[ -z "$context" ]]; then
  log_warn "No context class set (context:work or context:private) — only yadm will be installed"
elif [[ -z "$type_val" ]]; then
  log_warn "No type class set (type:physical or type:vm) — only yadm will be installed"
else
  # general_{context}_{type} is always installed — it is the shared base layer
  desired_profiles+=("general_${context}_${type_val}")
  # role delta profiles: {role}_{context}_{type} (skipped silently if no flake output)
  # role:general is intentionally excluded — it maps to the base profile already added above
  for class in "${classes[@]}"; do
    case "$class" in
      role:general) ;;
      role:*)
        local role="${class#role:}"
        desired_profiles+=("${role}_${context}_${type_val}")
        ;;
      context:*|type:*) ;;
      *)
        log_warn "Ignoring unknown machine class: $class"
        ;;
    esac
  done
fi

# Remove profiles installed from this flake that are no longer desired
while IFS= read -r profile; do
  if ! has_value "$profile" "${desired_profiles[@]}"; then
    log_step "Removing Nix profile: $profile"
    nix profile remove "$profile"
  fi
done < <(installed_profiles_from_this_flake)

log_step "Profiles: ${desired_profiles[*]}"

for profile in "${desired_profiles[@]}"; do
  current_url=$(get_profile_url "$profile")
  if [[ -n "$current_url" && "$current_url" != "path:${FLAKE}" ]]; then
    log_step "Removing stale Nix profile (wrong source): $profile"
    nix profile remove "$profile"
    current_url=""
  fi

  if [[ -n "$current_url" ]]; then
    log_step "Upgrading Nix profile: $profile"
    nix profile upgrade "$profile"
  elif nix profile add "path:${FLAKE}#${profile}" 2>/dev/null; then
    log_done "Installed Nix profile: $profile"
  fi
done

# Remove packages that were installed by the setup script for bootstrapping
# and are now provided by nix.
if command -v brew >/dev/null 2>&1; then
  for pkg in yadm; do
    if brew list --formula "$pkg" &>/dev/null; then
      log_step "Removing bootstrap brew package: $pkg (now provided by nix)"
      brew uninstall "$pkg" || log_warn "Could not remove $pkg from brew"
    fi
  done
fi

log_done
