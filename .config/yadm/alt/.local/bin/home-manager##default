#!/usr/bin/env bash
# Prefer this over the Home Manager on PATH and default `switch`/`build`
# to the yadm flake configuration for this machine.
set -euo pipefail

flake="${XDG_CONFIG_HOME:-$HOME/.config}/yadm"
self=$(readlink -f "$0")

real=""
IFS=':' read -ra dirs <<< "$PATH"
for dir in "${dirs[@]}"; do
  candidate="${dir}/home-manager"
  [[ -x "$candidate" ]] || continue
  [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
  real=$candidate
  break
done

if [[ -z "$real" ]]; then
  echo "home-manager is not installed yet. Run: ~/.config/yadm/bootstrap.d/037-switch-home-manager" >&2
  exit 1
fi

needs_flake=0
has_flake=0
for arg in "$@"; do
  case "$arg" in
    switch|build) needs_flake=1 ;;
    --flake|--flake=*) has_flake=1 ;;
  esac
done

if [[ "$needs_flake" -eq 1 && "$has_flake" -eq 0 ]]; then
  if [[ ! -f "$flake/home/machine.nix" ]]; then
    echo "Missing $flake/home/machine.nix. Run: yadm alt" >&2
    exit 1
  fi
  system=$(nix eval --impure --raw --expr builtins.currentSystem)
  args=()
  for arg in "$@"; do
    args+=("$arg")
    if [[ "$arg" == switch || "$arg" == build ]]; then
      args+=(--flake "${flake}#${system}")
    fi
  done
  exec "$real" "${args[@]}"
fi

exec "$real" "$@"
